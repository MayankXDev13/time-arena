{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "app/**", "components/**", "db/**", "drizzle/**", "hooks/**", "lib/**", "stores/**", "types/**", "utils/**", "package.json", "tsconfig*.json", "vite.config.*", "vitest.config.*", "next.config.*", "postcss.config.*", "index.html"],
      "outputs": ["dist/**", ".next/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build"],
      "inputs": ["src/**", "app/**", "components/**", "db/**", "drizzle/**", "hooks/**", "lib/**", "stores/**", "types/**", "utils/**", "package.json", "tsconfig*.json", "vite.config.*", "vitest.config.*", "next.config.*", "postcss.config.*", "index.html"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
